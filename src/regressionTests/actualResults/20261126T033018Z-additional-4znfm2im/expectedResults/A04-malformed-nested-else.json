  "layout": [
    [
      2,
      "INDENT"
    ],
    [
      3,
      "INDENT"
    ],
    [
      4,
      "DEDENT"
    ],
    [
      5,
      "INDENT"
    ],
    [
      6,
      "INDENT"
    ],
    [
      7,
      "DEDENT"
    ],
    [
      7,
      "DEDENT"
    ],
    [
      8,
      "DEDENT"
    ]
  ],
  "parsed": [
    [
      "literal",
      "CONST_STRING",
      "\"first\"",
      2
    ],
    [
      "literal",
      "CONST_STRING",
      "\"kept outer\"",
      1
    ],
    [
      "literal",
      "CONST_STRING",
      "\"kept global\"",
